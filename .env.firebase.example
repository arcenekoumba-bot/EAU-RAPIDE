# Copie ce fichier en .env.local et remplace les valeurs depuis
# Firebase Console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=REMPLACE_MOI
VITE_FIREBASE_AUTH_DOMAIN=REMPLACE_MOI.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=REMPLACE_MOI
VITE_FIREBASE_STORAGE_BUCKET=REMPLACE_MOI.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=REMPLACE_MOI
VITE_FIREBASE_APP_ID=REMPLACE_MOI
