rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow create, read, update: if isOwner(userId);
      allow delete: if false;
    }

    match /drivers/{driverId} {
      // Les profils publiés et disponibles sont consultables sans compte
      // pour permettre aux clients de découvrir les livreurs.
      allow read: if isOwner(driverId)
        || (resource.data.approved == true && resource.data.available == true);
      // L'inscription livreur est en libre-service : le propriétaire peut
      // publier son profil, mais pas modifier les statistiques de confiance.
      allow create: if isOwner(driverId)
        && request.resource.data.approved == true
        && request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.zone is string
        && request.resource.data.zone.size() > 1
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 8
        && request.resource.data.unitPrice is number
        && request.resource.data.unitPrice > 0
        && request.resource.data.available is bool;
      allow update: if isOwner(driverId)
        && request.resource.data.approved == true
        && request.resource.data.rating == resource.data.rating
        && request.resource.data.deliveries == resource.data.deliveries;
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'Demandée';

      allow read: if signedIn()
        && (resource.data.customerId == request.auth.uid
          || resource.data.driverId == request.auth.uid);

      // Le client peut annuler sa commande demandée. Le livreur peut faire évoluer
      // le statut d'une commande qui lui est attribuée. Les règles finales seront
      // renforcées avec l'authentification des rôles dans l'incrément suivant.
      allow update: if signedIn()
        && ((resource.data.customerId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.driverId == resource.data.driverId
          && request.resource.data.status == 'Annulée')
        || (resource.data.driverId == request.auth.uid
          && request.resource.data.driverId == resource.data.driverId
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.total == resource.data.total
          && request.resource.data.address == resource.data.address
          && request.resource.data.quantity == resource.data.quantity
          && request.resource.data.status in ['Acceptée', 'En route', 'Livrée', 'Annulée']));

      allow delete: if false;
    }
  }
}
